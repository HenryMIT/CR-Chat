# =============================================================================
# Variables de docker-compose.yml de CR_Chat. Copia este archivo a .env (está
# ignorado por git) y pon valores propios. NO hay valores por defecto para los
# secretos: compose se niega a arrancar si falta alguno.
# Generar un secreto:  openssl rand -base64 24 | tr -d '/+='
# =============================================================================

# --- General -------------------------------------------------------------------
DB_NAME=cr_chat
TZ=America/Costa_Rica

# --- PostgreSQL / Patroni (pg1, pg2) ---------------------------------------------
# Superusuario `postgres`: solo lo usan Patroni, dbmate (001) y db-init.
POSTGRES_SUPERUSER_PASSWORD=
# Usuario `replicator` (streaming entre nodos).
PATRONI_REPLICATION_PASSWORD=
# API REST de Patroni: protege PATCH /config, switchover, restart.
PATRONI_RESTAPI_USERNAME=patroni
PATRONI_RESTAPI_PASSWORD=

# --- Roles de la aplicación (Postgres/bootstrap/asignar-credenciales.sql) --------
DB_MIGRATOR_PASSWORD=
# API: escritura por haproxy:5000
DB_APP_RW_PASSWORD=
# API: lectura por haproxy:5001
DB_APP_RO_PASSWORD=
# Debezium (rol cdc_lector, REPLICATION). Vacío = CDC deshabilitado (NOLOGIN).
DB_CDC_PASSWORD=

# --- MinIO -------------------------------------------------------------------------
# root: solo minio-init
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Usuario de respaldos (bucket cr-chat-backups): pg1, pg2, backup
MINIO_BACKUP_ACCESS_KEY=
MINIO_BACKUP_SECRET_KEY=
# Usuario de la API (bucket cr-chat-media): web-datos / ws
MINIO_API_ACCESS_KEY=
MINIO_API_SECRET_KEY=
# Origen permitido (CORS) para subidas prefirmadas desde el navegador
MINIO_CORS_ORIGIN=http://localhost:5173

# --- pgBackRest -------------------------------------------------------------------
# Clave de cifrado del repositorio (aes-256-cbc). PERDERLA = perder los respaldos:
# guárdala también fuera del servidor (gestor de secretos).
PGBACKREST_CIPHER_PASS=

# --- CDC (profile cdc) --------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
# Debezium JDBC sink (DDL/DML sobre crchat)
MYSQL_SINK_PASSWORD=
# Usuario de lectura de la app / reportes (solo SELECT)
MYSQL_READER_PASSWORD=
# Id del clúster KRaft (base64 de 16 bytes; no es secreto)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Puertos publicados (siempre en 127.0.0.1) --------------------------------------
PG_RW_PORT=5000
PG_RO_PORT=5001
HAPROXY_STATS_PORT=7000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MYSQL_PORT=3306
CONNECT_PORT=8083

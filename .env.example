# Credenciales de los contenedores de base de datos (docker-compose.yml).
# Copia este archivo a .env y cambia los valores. Si no existe .env, se usan
# los valores por defecto de desarrollo (admin/admin).
# Los scripts de respaldo toman estas mismas variables al arrancar cada contenedor.
DB_NAME=CR_Chat
MYSQL_USER=admin
MYSQL_PASSWORD=cambiar
MYSQL_ROOT_PASSWORD=cambiar
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambiar

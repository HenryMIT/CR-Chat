# Variables del frontend de CR_Chat. Copia este archivo a .env.local y ajústalo.
# Todas llevan el prefijo VITE_ porque Vite solo expone esas al navegador.
# NUNCA pongas secretos aquí: todo lo que empiece por VITE_ termina en el bundle público.
# En Docker (servicio web) estos valores se pasan como variables de entorno desde
# docker-compose.yml; una variable del entorno tiene prioridad sobre este archivo.

# URL base de la API REST v1 (servicio web-datos).
VITE_API_URL=http://localhost:8000/api/v1

# URL del servidor WebSocket (servicio ws, Workerman). En producción: wss://
VITE_WS_URL=ws://localhost:8080/ws

# true  = la app usa MSW (API y WebSocket simulados en el navegador, datos de demo).
# false = la app habla con el backend real en VITE_API_URL y VITE_WS_URL.
VITE_USE_MOCKS=true

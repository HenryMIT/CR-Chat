# Motor preferido al arrancar (pg | mysql). Si no responde, se usa el otro.
db_primary='mysql'
hostPG='serverPG'
portPG='5432'
hostMYSQL='servermysql'
portMYSQL='3306'
db='CR_Chat'
usrPG='admin'
usrMYSQL='admin'
passPG='cambiar'
passMYSQL='cambiar'
# Clave usada por los SP para cifrar contraseñas, emails y mensajes. No cambiarla con datos existentes.
key_decryption='cambiar'
# Clave HS256 para firmar los JWT (mínimo 32 caracteres)
key='cambiar-por-una-clave-larga-y-aleatoria'
jwt_access_ttl=900
jwt_refresh_ttl=604800
cors_origin='http://localhost:4200'
app_debug=false

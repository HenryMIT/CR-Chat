# Variables de la API (web-datos) y del servidor WebSocket (ws). Copia a datos/.env y cambia
# TODOS los valores marcados "cambiar". Ningún valor de este archivo es un secreto real.
# Generar claves:  openssl rand -base64 32   (MSG_ENC_KEY)   ·   openssl rand -base64 48   (JWT_ACCESS_KEY)

# production | development | test. En production APP_DEBUG se fuerza a false.
APP_ENV=development
APP_DEBUG=false

# --- PostgreSQL (única fuente de verdad; ver docs/contratos/db-funciones.md §1) ---------------
DB_NAME=cr_chat
DB_RW_HOST=haproxy
DB_RW_PORT=5000
DB_RW_USER=app_rw
DB_RW_PASSWORD=cambiar
DB_RO_HOST=haproxy
DB_RO_PORT=5001
DB_RO_USER=app_ro
DB_RO_PASSWORD=cambiar

# --- JWT de acceso (HS256, clave propia, mínimo 32 bytes) ------------------------------------
JWT_ACCESS_KEY=cambiar-por-una-clave-larga-y-aleatoria-de-al-menos-32-bytes
JWT_ACCESS_TTL=900
JWT_ISSUER=cr-chat-api
JWT_AUDIENCE=cr-chat
# Refresh opaco: vida deslizante y máximo absoluto (días)
REFRESH_TTL_DAYS=30
REFRESH_MAX_DAYS=90
# Cookie HttpOnly del refresh (modo web, A-15). Solo se puede poner false fuera de production.
REFRESH_COOKIE_SECURE=false

# --- Cifrado de mensajes (libsodium XChaCha20-Poly1305): 32 bytes en base64 ------------------
MSG_ENC_KEY=Y2FtYmlhci1wb3ItMzItYnl0ZXMtYWxlYXRvcmlvcyE=
MSG_ENC_KEY_ID=1
# Claves anteriores tras rotar (solo para descifrar): "1:base64,2:base64"
MSG_ENC_KEYS_OLD=

# --- Redis (sesiones activas, rate limiting, pub/sub del WS) ---------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cambiar
REDIS_DB=0

# --- MinIO / S3 (avatares y adjuntos con URL prefirmada) -------------------------------------
# MINIO_ENDPOINT: red interna (HEAD/DELETE del servidor). MINIO_PUBLIC_ENDPOINT: el que ve el navegador.
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=cambiar
MINIO_SECRET_KEY=cambiar
MINIO_BUCKET=cr-chat-media
# Segundos entre ejecuciones del job de huérfanos (worker cr-chat-tareas del servicio ws)
MEDIA_PURGE_INTERVAL=3600

# --- HTTP ---------------------------------------------------------------------------------
# Orígenes permitidos (CORS y Origin del handshake WS), separados por comas. Nunca "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
# Proxies de confianza (CIDR) cuyo X-Forwarded-For se respeta para la IP real
TRUSTED_PROXIES=
# Rate limiting (docs/requerimientos-api.md §6). Cada política se puede sobrescribir:
# RL_<POLITICA>=límite/segundos[,límite/segundos], p. ej. RL_REGISTER=3/3600
RATE_LIMIT_ENABLED=true
# Swagger UI en /docs y contrato en /docs/openapi.yaml
DOCS_ENABLED=true

# --- WebSocket (servicio ws) ----------------------------------------------------------------
WS_PORT=8080
WS_WORKERS=1

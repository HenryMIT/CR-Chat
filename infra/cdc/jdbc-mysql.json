{
  "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
  "tasks.max": "1",
  "topics": "crchat.public.usuario,crchat.public.media,crchat.public.contacto,crchat.public.bloqueo,crchat.public.conversacion,crchat.public.participante,crchat.public.mensaje,crchat.public.recibo_mensaje",
  "consumer.override.metadata.max.age.ms": "30000",
  "connection.url": "jdbc:mysql://mysql:3306/crchat?useSSL=false&allowPublicKeyRetrieval=true",
  "connection.username": "crchat_sink",
  "connection.password": "${env:MYSQL_SINK_PASSWORD}",
  "insert.mode": "upsert",
  "delete.enabled": "true",
  "truncate.enabled": "true",
  "primary.key.mode": "record_key",
  "schema.evolution": "none",
  "use.time.zone": "UTC",
  "transforms": "ruta",
  "transforms.ruta.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.ruta.regex": "crchat\\.public\\.(.+)",
  "transforms.ruta.replacement": "$1",
  "errors.tolerance": "none",
  "errors.retry.timeout": "300000"
}

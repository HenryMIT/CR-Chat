{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "haproxy",
  "database.port": "5000",
  "database.user": "cdc_lector",
  "database.password": "${env:DB_CDC_PASSWORD}",
  "database.dbname": "${env:DB_NAME}",
  "database.tcpKeepAlive": "true",
  "topic.prefix": "crchat",
  "plugin.name": "pgoutput",
  "publication.name": "crchat_cdc",
  "publication.autocreate.mode": "disabled",
  "slot.name": "debezium_crchat",
  "slot.drop.on.stop": "false",
  "table.include.list": "public.usuario,public.media,public.contacto,public.bloqueo,public.conversacion,public.participante,public.mensaje,public.recibo_mensaje",
  "column.exclude.list": "public.usuario.pass_hash",
  "snapshot.mode": "initial",
  "binary.handling.mode": "bytes",
  "decimal.handling.mode": "precise",
  "interval.handling.mode": "string",
  "tombstones.on.delete": "true",
  "heartbeat.interval.ms": "10000",
  "errors.max.retries": "-1",
  "retriable.restart.connector.wait.ms": "5000",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "1",
  "topic.creation.default.cleanup.policy": "compact",
  "topic.creation.default.retention.ms": "604800000"
}
